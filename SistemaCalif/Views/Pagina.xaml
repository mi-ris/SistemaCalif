<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SistemaCalif.Views.Pagina"
             BackgroundColor="#0B0B0C"
             Title="Portal Académico - Instituto Sudamericano">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="580" HorizontalOptions="Center">

            <!-- 1. Cabecera Institucional y Barra de Estado -->
            <Border BackgroundColor="#161618" Stroke="#FFB7B2" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="14">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Label Grid.Column="0" Text="🏛️" FontSize="22" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Margin="8,0,0,0">
                            <Label Text="INSTITUTO SUDAMERICANO" TextColor="#FFB7B2" FontSize="15" FontAttributes="Bold"/>
                            <Label Text="Sistema de Gestión y Registro de Notas" TextColor="#AAAAAA" FontSize="11"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="#1E2A22" Stroke="#B5EAD7" StrokeShape="RoundRectangle 8" Padding="8,4" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="●" TextColor="#B5EAD7" FontSize="10" VerticalOptions="Center"/>
                                <Label Text="En Línea" TextColor="#B5EAD7" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 2. Panel de Métricas / Configuración del Sistema -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                <Border Grid.Column="0" BackgroundColor="#161618" Stroke="#333" StrokeShape="RoundRectangle 10" Padding="8">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="Escala" TextColor="#777" FontSize="10" HorizontalOptions="Center"/>
                        <Label Text="0.1 - 10.0" TextColor="#E2F0CB" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="#161618" Stroke="#333" StrokeShape="RoundRectangle 10" Padding="8">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="Seguimiento" TextColor="#777" FontSize="10" HorizontalOptions="Center"/>
                        <Label Text="30% (0.3)" TextColor="#FFDAC1" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" BackgroundColor="#161618" Stroke="#333" StrokeShape="RoundRectangle 10" Padding="8">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="Examen" TextColor="#777" FontSize="10" HorizontalOptions="Center"/>
                        <Label Text="20% (0.2)" TextColor="#C7CEEA" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- 3. Selector de Estudiante (Corregido para visibilidad perfecta) -->
            <Border BackgroundColor="#161618" Stroke="#B5EAD7" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="👤 SELECCIÓN DE ESTUDIANTE (Listado Oficial)" TextColor="#B5EAD7" FontAttributes="Bold" FontSize="11"/>
                    <Picker x:Name="pickerEstudiantes" 
                            Title="Seleccione un estudiante..." 
                            TextColor="White" 
                            TitleColor="#888" 
                            BackgroundColor="#242428"
                            FontSize="13" 
                            HeightRequest="42">
                        <Picker.Items>
                            <x:String>Carla Gómez</x:String>
                            <x:String>Mateo Ruiz</x:String>
                            <x:String>Sofía Morales</x:String>
                            <x:String>Alejandro Vera</x:String>
                            <x:String>Valeria Torres</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <!-- 4. Sección Parcial 1 -->
            <Border BackgroundColor="#161618" Stroke="#FFDAC1" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="📊 PRIMER PARCIAL" TextColor="#FFDAC1" FontAttributes="Bold" FontSize="12"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="Nota Seguimiento 1" TextColor="#AAA" FontSize="10"/>
                            <Entry x:Name="txtSeguimiento1" Placeholder="0.1 - 10" PlaceholderColor="#555" TextColor="White" BackgroundColor="#202023" FontSize="12" HeightRequest="38" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Examen 1" TextColor="#AAA" FontSize="10"/>
                            <Entry x:Name="txtExamen1" Placeholder="0.1 - 10" PlaceholderColor="#555" TextColor="White" BackgroundColor="#202023" FontSize="12" HeightRequest="38" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 5. Sección Parcial 2 -->
            <Border BackgroundColor="#161618" Stroke="#C7CEEA" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="📊 SEGUNDO PARCIAL" TextColor="#C7CEEA" FontAttributes="Bold" FontSize="12"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="Nota Seguimiento 2" TextColor="#AAA" FontSize="10"/>
                            <Entry x:Name="txtSeguimiento2" Placeholder="0.1 - 10" PlaceholderColor="#555" TextColor="White" BackgroundColor="#202023" FontSize="12" HeightRequest="38" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Examen 2" TextColor="#AAA" FontSize="10"/>
                            <Entry x:Name="txtExamen2" Placeholder="0.1 - 10" PlaceholderColor="#555" TextColor="White" BackgroundColor="#202023" FontSize="12" HeightRequest="38" Keyboard="Numeric"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 6. Fecha de Registro -->
            <Border BackgroundColor="#161618" Stroke="#E2F0CB" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="📅 FECHA DE EVALUACIÓN" TextColor="#E2F0CB" FontAttributes="Bold" FontSize="11"/>
                    <DatePicker x:Name="datePickerFecha" TextColor="White" FontSize="12" HeightRequest="40" />
                </VerticalStackLayout>
            </Border>

            <!-- 7. Botones de Acción (Calcular y Limpiar) -->
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" Margin="0,4,0,0">
                <Button Grid.Column="0" x:Name="btnCalcular" 
                        Text="CALCULAR CALIFICACIONES" 
                        BackgroundColor="#FFB7B2" 
                        TextColor="#121212" 
                        FontAttributes="Bold" 
                        CornerRadius="12" 
                        HeightRequest="46"
                        FontSize="12"
                        Clicked="OnCalcularClicked"/>

                <Button Grid.Column="1" x:Name="btnLimpiar" 
                        Text="Limpiar" 
                        BackgroundColor="#2A2A2E" 
                        TextColor="#CCC" 
                        FontAttributes="Bold" 
                        CornerRadius="12" 
                        HeightRequest="46"
                        FontSize="12"
                        WidthRequest="90"
                        Clicked="OnLimpiarClicked"/>
            </Grid>

            <!-- 8. Panel Dashboard de Resultados en Vivo -->
            <Border x:Name="cardResultados" BackgroundColor="#141416" Stroke="#E2F0CB" StrokeThickness="1.5" StrokeShape="RoundRectangle 14" Padding="14" IsVisible="False" Margin="0,4,0,10">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="📋" FontSize="16"/>
                        <Label Text="INFORME DE RENDIMIENTO ACADÉMICO" TextColor="#E2F0CB" FontAttributes="Bold" FontSize="13" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="#2A2A2E" Margin="0,2"/>

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Estudiante Evaluado:" TextColor="#AAA" FontSize="12"/>
                        <Label x:Name="lblResNombre" Grid.Row="0" Grid.Column="1" Text="-" TextColor="White" FontAttributes="Bold" FontSize="12"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Calificación Parcial 1:" TextColor="#AAA" FontSize="12"/>
                        <Label x:Name="lblResParcial1" Grid.Row="1" Grid.Column="1" Text="0.00" TextColor="#FFDAC1" FontAttributes="Bold" FontSize="12"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Calificación Parcial 2:" TextColor="#AAA" FontSize="12"/>
                        <Label x:Name="lblResParcial2" Grid.Row="2" Grid.Column="1" Text="0.00" TextColor="#C7CEEA" FontAttributes="Bold" FontSize="12"/>

                        <Label Grid.Row="3" Grid.Column="0" Text="Nota Final Global:" TextColor="#AAA" FontSize="12"/>
                        <Label x:Name="lblResNotaFinal" Grid.Row="3" Grid.Column="1" Text="0.00" TextColor="#B5EAD7" FontAttributes="Bold" FontSize="13"/>

                        <Label Grid.Row="4" Grid.Column="0" Text="Estado del Estudiante:" TextColor="#AAA" FontSize="12"/>
                        <Label x:Name="lblResEstado" Grid.Row="4" Grid.Column="1" Text="-" TextColor="#FFB7B2" FontAttributes="Bold" FontSize="12"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>